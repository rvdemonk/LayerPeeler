# nginx server block for the storefront.
#
# Derived from the "static" flavour of /root/templates/nginx-site.template on
# the droplet. Copy to /etc/nginx/sites-available/<app>, edit the two tokens
# below, symlink into sites-enabled/, `nginx -t`, then reload.
#
#   <APP>     the app name, e.g. lottie-store  (also the /var/www dir)
#   <DOMAIN>  the hostname, e.g. lottie.3rigby.xyz
#
# After this is live: certbot --nginx -d <DOMAIN>, then add a row to
# /root/REGISTER.md in the SAME session. No port is claimed — this is static
# files off disk, no upstream service, no systemd unit.

server {
    listen 80;
    listen [::]:80;
    server_name <DOMAIN>;

    root /var/www/<APP>;
    index index.html;

    access_log /var/log/nginx/<APP>.access.log;
    error_log  /var/log/nginx/<APP>.error.log;

    # ---------------------------------------------------------------
    # The whole point of this block. The Lottie clips are ~2 MB of JSON
    # each and compress to ~73%. build-gz.sh writes a .gz beside every
    # asset; gzip_static serves it directly with no per-request CPU on a
    # 1-vCPU box. `gzip on` stays as the fallback for anything without a
    # precompressed twin.
    # ---------------------------------------------------------------
    gzip_static on;
    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json
               image/svg+xml;

    # Clips and the vendored player are content-addressed by hand (they only
    # change when a clip is replaced), so a day of caching is safe and keeps
    # repeat visits from re-pulling 8 MB. Drop to no-cache while iterating.
    location ~* ^/assets/ {
        expires 1d;
        add_header Cache-Control "public, max-age=86400";
    }

    # The page itself must never be stale — pricing and the Stripe link live
    # in it.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri $uri/ =404;
    }

    # Nothing here is user-supplied and nothing is executed server-side, but
    # these cost nothing.
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
}
